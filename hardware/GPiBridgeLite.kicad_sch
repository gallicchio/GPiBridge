	(text "GPiBridge Lite: USB-C to IEEE-488 (GPIB)"
		(exclude_from_sim no)
		(at 17.78 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "78f76660-c9fe-13ad-9690-cd472f63162a")
	)
	(text_box "R30-R45: 100 R in every\nline (R30 + the GPIO\nnumber). They hold the\ncurrent to about 35 mA if\nan instrument drives a\nline high while the\nRP2354A holds it low, and\nstatic on a contact\nreaches the pin through\nthem. A line held low sits\nat about 0.25 V with one\ninstrument's terminations\non it (3 k to 5 V, 6.2 k\nto ground), about 0.6 V\nwith three (TTL low: under\n0.8 V)."
		(exclude_from_sim no)
		(at 288.29 121.92 0)
		(size 25.4 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "15b255d3-c8b8-b621-9d45-7b8b4579631f")
	)
	(text_box "UART0 console, 115200 baud: the\nDebug Probe's 'U' cable. Works\nwhen USB does not."
		(exclude_from_sim no)
		(at 17.78 207.01 0)
		(size 30.48 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
