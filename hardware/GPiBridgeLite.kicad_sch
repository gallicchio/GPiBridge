		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "21510f46-6883-6fb0-509d-f97190b8ef63")
	)
	(text_box "BUS (green): lit while the firmware is\non the bus. BUS_PWR_EN is the signal\nthat switches GPiBridge's transceivers\non, which lights the same LED there."
		(exclude_from_sim no)
		(at 292.1 59.69 0)
		(size 35.56 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
