				(size 1 1)
			)
			(justify left top)
		)
		(uuid "b3511b97-8e62-abac-8f20-38e09e5b92d3")
	)
	(text_box "IEEE-488 plug, hand-\nsoldered. Contacts\n1-12 run along the\nwide side of the D.\nTTL levels, low =\ntrue. The RP2354A's\nbus pins are 5 V\ntolerant while it is\npowered (5.5 V max)\nand take up to 3.63 V\nwhile it is not: a\nstandard bus idles at\nabout 3.4 V."
		(exclude_from_sim no)
		(at 344.17 88.9 0)
		(size 21.59 25.4)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "bbe8594d-5446-9be5-4276-5d8f3870abcb")
	)
	(text_box "CC1, CC2: 5.1 k to ground say\n'device'; the host then gives 5\nV."
		(exclude_from_sim no)
		(at 77.47 74.93 0)
		(size 29.21 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
