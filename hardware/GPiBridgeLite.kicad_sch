				(size 1 1)
			)
			(justify left top)
		)
		(uuid "51486703-5856-32aa-a222-0eb6d584d8f5")
	)
	(text_box "XC6206: 3.3 V, 200 mA, for the\nRP2354A only (about 50 mA).\nDropout 0.25 V at 100 mA: a USB\nport sagging to 4.4 V still gives\n3.3 V."
		(exclude_from_sim no)
		(at 69.85 35.56 0)
		(size 31.75 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "63b1c84d-6ab8-862f-50ad-6d4c775ea9b1")
	)
	(text_box "H1, H2: M2 holes; the two\nscrews that close the housing\npass through them."
		(exclude_from_sim no)
		(at 101.6 251.46 0)
		(size 27.94 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
