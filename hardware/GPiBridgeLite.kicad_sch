		)
		(uuid "d0f5637c-41af-8c5f-cc6b-164172fa2958")
	)
	(text_box "The 2 MB flash is inside\nthe RP2354A; these stay\nopen."
		(exclude_from_sim no)
		(at 93.98 171.45 0)
		(size 22.86 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
