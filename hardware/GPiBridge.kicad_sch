		)
		(uuid "4904d05e-8bd5-7c17-2846-c043883d999b")
	)
	(text_box "USB-C. Takes 5 V, up to 270 mA\n(each transceiver 110 mA max);\nthe transceivers wait for the\nhost's 300 mA."
		(exclude_from_sim no)
		(at 15.24 114.3 0)
		(size 30.48 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
