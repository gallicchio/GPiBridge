			(justify left top)
		)
		(uuid "4c0b61e5-7af5-158d-f47e-a26a7089c75a")
	)
	(text_box "ABM8-272-T3, 12 MHz, 10 pF load: the\ncrystal Raspberry Pi specifies, with\ntheir 15 pF loads and the 1 k that\nlimits its drive."
		(exclude_from_sim no)
		(at 88.9 120.65 0)
		(size 36.83 10.16)
