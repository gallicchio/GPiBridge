	(text "GPiBridge: USB-C to IEEE-488 (GPIB)"
		(exclude_from_sim no)
		(at 17.78 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d071d328-2ebc-6ce4-ab37-7b2923a8d07c")
	)
	(text_box "The transceivers get 5 V only when the firmware sets\nBUS_PWR_EN, after it has released every line. In reset,\ncrashed or blank, they are off, and TI's parts do not load\nan unpowered bus. It also keeps 5 V off the RP2354A's pins\nwhile it is unpowered: they tolerate 5 V only when powered."
		(exclude_from_sim no)
		(at 251.46 35.56 0)
		(size 53.34 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0e228b10-a839-0654-6a5b-b4373fb3791f")
	)
	(text_box "H1, H2: M2 holes; the two\nscrews that close the housing\npass through them."
		(exclude_from_sim no)
		(at 101.6 251.46 0)
		(size 27.94 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
