		(uuid "55666a8b-d6ec-ddc0-48e4-b5b4051662d8")
	)
	(text_box "The 2 MB flash is inside\nthe RP2354A; these stay\nopen."
		(exclude_from_sim no)
		(at 93.98 171.45 0)
		(size 22.86 7.62)
