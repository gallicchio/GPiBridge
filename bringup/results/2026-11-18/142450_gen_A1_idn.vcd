$var wire 1 . REN $end
$var wire 1 / ATN $end
$var wire 1 0 SRQ $end
$var wire 1 1 TE_DATA $end
$var wire 1 2 TE_CTRL $end
$var wire 1 3 DC $end
$var wire 1 4 PE $end
$var wire 1 5 BUS_PWR_EN $end
$enddefinitions $end
